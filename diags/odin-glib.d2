# odin-glib: its place in the binding graph
# Render:  d2 diags/odin-glib.d2 diags/odin-glib.svg

direction: down

title: "odin-glib" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-glib\nGLib, GObject and GIO 2.80.0" {
  style.fill: "#eef6ff"
}
lib: "glib-2.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"glib:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection glib
this -> lib: foreign import
